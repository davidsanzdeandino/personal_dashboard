# Copia este archivo a ".env" y rellena tus valores.
# Supabase: botón "Connect" del proyecto, o Settings → API Keys.
#
# Solo las variables con prefijo VITE_ llegan al navegador. La publishable key
# es segura en el cliente: el acceso a datos está protegido por RLS.

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# IMPORTANTE: la clave SECRETA de Stripe NO va aquí ni en el frontend.
# Se guarda como secreto de la Edge Function en Supabase:
#   supabase secrets set STRIPE_SECRET_KEY=sk_live_...
# (ver README -> "Integraciones opcionales" / "Optional integrations")
